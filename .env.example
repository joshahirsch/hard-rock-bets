# =============================================================================
# Hard Rock Bet research pipeline -- EXAMPLE environment
# =============================================================================
# Copy to .env and fill in your own values. .env is git-ignored and must NEVER
# be committed. Every value below is a placeholder.
# =============================================================================

# --- Owls Insight odds API (https://api.owlsinsight.com) ---------------------
# Auth is `Authorization: Bearer <key>` ONLY -- a ?apiKey= query param 403s.
# This service calls the vendor directly, server-side; there is no relay.
OWLS_INSIGHT_API_KEY=your-owls-insight-api-key-here

# --- Google Sheets (Decision Log tracker) ------------------------------------
# The tracker spreadsheet ID, i.e. the long token in the sheet URL:
#   https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id-here
# Tab within that spreadsheet holding the A-Y Decision Log schema.
GOOGLE_SHEETS_DECISION_LOG_TAB=Decision Log
# Absolute path to a Google service-account JSON key with Sheets scope.
# Share the spreadsheet with that service account's email address.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#
# ALTERNATIVE to the above: if your Google Cloud org blocks service-account
# key creation (constraint `iam.disableServiceAccountKeyCreation`) and you
# don't have org-admin rights to override it, use OAuth instead -- set these
# three and leave GOOGLE_APPLICATION_CREDENTIALS unset. Generate them with
# `python scripts/get_oauth_refresh_token.py /path/to/client_secret.json`
# (see that file's docstring for the one-time Cloud Console setup).
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-oauth-refresh-token

# --- Bankroll ----------------------------------------------------------------
# Used ONLY by the flat suggested-stake formula
# (min($10, floor(10% x bankroll)), floored at $1).
# Informational only -- nothing in this codebase can place a wager.
# Do not commit a real figure.
BANKROLL_USD=100

# --- App ---------------------------------------------------------------------
HRB_CONFIG_PATH=config/config.yaml
HRB_SERVICE_HOST=127.0.0.1
HRB_SERVICE_PORT=8000
